nothingelsematters_metallifacts = {
	array = [
		{
			time = 10.0
			text = qs("'Nothing Else Matters' is the eighth track on Metallica's self-titled album from 1991 also known as the Black album.")
		}
		{
			time = 25.0
			text = qs("'Nothing Else Matters' was debuted live on March 2, 1992 in Cincinnati, OH.")
		}
		{
			time = 35.0
			text = qs("James Hetfield said that he came up with the main pattern by accident.  He was on the phone and only had one hand free, and he strummed the open E, G, B and high E strings on his guitar.")
		}
		{
			time = 50.0
			text = qs("Lyrically, the song is about being on the road for a long time and missing home.")
		}
		{
			time = 60.0
			text = qs("Originally, James didn't intend 'Nothing Else Matters' to be a Metallica song.  He was afraid the rest of the band wouldn't like it and felt it wasn't Metallica material.")
		}
		{
			time = 75.0
			text = qs("Producer Bob Rock suggested that the band have an orchestra play on the song.")
		}
		{
			time = 85.0
			text = qs("James Hetfield wrote the string part of the song using an e-bow which is an electric guitar bow that vibrates the strings without plucking them.")
		}
		{
			time = 100.0
			text = qs("The e-bow was a frequently used piece of equipment by one of James' favorite guitarists Queen's Brian May.")
		}
		{
			time = 115.0
			text = qs("Michael Kamen who had previously worked with Pink Floyd on 'The Wall' album was brought in to arrange the string parts.")
		}
		{
			time = 130.0
			text = qs("Kamen didn't meet the band until years later backstage at the Grammy's.  Metallica played him the 'elevator version' of 'Nothing Else Matters' which had just one guitar, James' voice and the orchestra.")
		}
		{
			time = 150.0
			text = qs("The 'elevator version' of the song appeared as a B-side on the single for 'Sad But True'.")
		}
		{
			time = 160.0
			text = qs("Michael Kamen encouraged the band to do a concert with an orchestra.  8 years later he was asked by the band to conduct the S&M concert.")
		}
		{
			time = 175.0
			text = qs("'Nothing Else Matters' is one of those rare Metallica songs where James Hetfield plays the solo.")
		}
		{
			time = 185.0
			text = qs("The video for the song was directed by Adam Dubin who also directed Metallica's 'A Year and a Half in the Life of Metallica'.")
		}
		{
			time = 203.0
			clear_text
		}
	]
}
one_metallifacts = {
	array = [
		{
			time = 10.0
			text = qs("'One' was Metallica's first top 40 hit single, peaking at #35 on the Billboard Hot 100 chart.")
		}
		{
			time = 20.0
			text = qs("'One' was debuted live on September 11, 1988 in Budapest, Hungary.  It was the opening date of the 'Damaged Justice' tour.")
		}
		{
			time = 35.0
			text = qs("'One' was also Metallica's first music video.")
		}
		{
			time = 45.0
			text = qs("The day the video premiered on MTV in February of 1989 it went straight to #1.  Thanks to Dial-In MTV which was a precursor to TRL.")
		}
		{
			time = 60.0
			text = qs("The song is inspired by the novel 'Johnny Got His Gun' by Dalton Trumbo that tells the story of a soldier who has lost his arms, and legs and who cannot speak, hear or see.")
		}
		{
			time = 75.0
			text = qs("There are two versions of the video for 'One'.  One where footage from the motion picture of 'Johnny Got His Gun' is incorporated with footage of the band playing in a warehouse...")
		}
		{
			time = 90.0
			text = qs("And the 'Jamming' version which just had the band jamming in the warehouse without the film footage.")
		}
		{
			time = 105.0
			text = qs("The video was shot in a warehouse in Long Beach, CA in early December 1988.")
		}
		{
			time = 115.0
			text = qs("'One' also appeared in Guitar Hero III: Legends of Rock as a playable track.")
		}
		{
			time = 125.0
			text = qs("The guitar solo for 'One' was ranked #7 on a list of 100 Greatest Guitar Solos compiled by Guitar World magazine...")
		}
		{
			time = 140.0
			text = qs("...Just before 'Hotel California' by The Eagles and directly after 'November Rain' by Guns N' Roses.")
		}
		{
			time = 155.0
			text = qs("Metallica performed 'One' live at the 31st Annual Grammy awards when the band was favored to win the first Best Hard Rock/Metal Performance Grammy...")
		}
		{
			time = 170.0
			text = qs("Metallica famously lost to Jethro Tull's 'Crest of a Knave'.")
		}
		{
			time = 180.0
			text = qs("After that Metallica started placing '1989 Grammy Losers' on subsequent copies of '...And Justice For All'.")
		}
		{
			time = 195.0
			text = qs("At the 32nd Annual Grammy Awards Metallica would win their first Grammy in the Best Metal Performance category for 'One'.")
		}
		{
			time = 210.0
			text = qs("On one of the nights of the Summer Sanitarium tour in 2000, Jonathan Davis of Korn and Daron Malakian of System of a Down joined Metallica on stage for a version of 'One'.")
		}
		{
			time = 228.0
			clear_text
		}
	]
}
orion_metallifacts = {
	array = [
		{
			time = 10.0
			text = qs("'Orion' is the only instrumental track on Metallica's 'Master of Puppets' album.")
		}
		{
			time = 20.0
			text = qs("Up until Metallica's self-titled 1991 album, every Metallica record had one instrumental song on it.  Well, mostly instrumental...")
		}
		{
			time = 35.0
			text = qs("...The song 'To Live is To Die' from 1988's '...And Justice for All' album is mostly instrumental except for the reading of a short poem written by Metallica's late bassist Cliff Burton.")
		}
		{
			time = 50.0
			text = qs("'Orion' was played at Cliff Burton's funeral on October 7th, 1986.")
		}
		{
			time = 60.0
			text = qs("Orion has many meanings.  In Greek Mythology, Orion is the name of a hunter who was placed in the sky as a constellation.")
		}
		{
			time = 70.0
			text = qs("In astronomy, Orion is a constellation lying on the celestial equator between Canis Major and Taurus.")
		}
		{
			time = 80.0
			text = qs("Metallica picked the name 'Orion' for the song because the middle part sounded 'spacey' and 'starry'.")
		}
		{
			time = 90.0
			text = qs("Drummer Lars Ulrich has said that 'Orion' started as bits and pieces of other songs thrown together.")
		}
		{
			time = 100.0
			text = qs("To celebrate the 20th anniversary of the release of the 'Master of Puppets' album, Mastodon did a version of 'Orion' for Kerrang! magazine.")
		}
		{
			time = 115.0
			text = qs("The first time Metallica had ever played 'Orion' in its entirety live was June 3, 2006 at the Rock Am Ring Festival in Germany.")
		}
		{
			time = 130.0
			text = qs("It was also the first time Metallica had played the 'Master of Puppets' album in its entirety to celebrate the 20th anniversary of its release.")
		}
		{
			time = 150.0
			text = qs("Lars Ulrich said that playing 'Orion' was the highlight of the set for him because it was like a tribute to Cliff.")
		}
		{
			time = 165.0
			text = qs("There are two bass solos in 'Orion' that are often mistaken for guitar solos.")
		}
		{
			time = 178.0
			clear_text
		}
	]
}
