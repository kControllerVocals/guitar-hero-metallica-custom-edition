		{
			time = 70.0
			text = qs("King Diamond first got the idea to wear make-up after a performance by Alice Cooper in 1975.")
		}
		{
			time = 80.0
			text = qs("King Diamond has said that Alice Cooper is one of his greatest influences.")
		}
		{
			time = 90.0
