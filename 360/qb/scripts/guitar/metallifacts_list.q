masterofpuppets_metallifacts = {
	array = [
		{
			time = 10.0
			text = qs("'Master of Puppets' is the second song on Metallica's 1986 album 'Master of Puppets'.")
		}
		{
			time = 25.0
			text = qs("The album was a breakthrough release for the band both musically and commercially.  The album even peaked at #29 on the U.S. Billboard 200.")
		}
		{
			time = 45.0
			text = qs("It was the first 'thrash' metal album to break into the Top 40, and it did so even though Metallica still received very little radio airplay.")
		}
		{
			time = 65.0
			text = qs("The album would go on to sell over 5 million copies in the U.S. alone.")
		}
		{
			time = 80.0
			text = qs("'Master of Puppets' is on top of a number of lists ranking it as one of the greatest metal albums of all time.")
		}
		{
			time = 105.0
			text = qs("Rolling Stone Magazine ranked 'Master of Puppets' at #33 in their 100 Greatest Guitar Songs of All Time.")
		}
		{
			time = 135.0
			text = qs("In a poll of the readers of Guitar World magazine, fans voted the solo to 'Master of Puppets' as the 51st greatest guitar solo of all time.")
		}
		{
			time = 155.0
			text = qs("Kirk Hammett has said that in the outro he played a bunch of guitar parts that were in the same key, then they flipped the tape over and played it backwards.")
		}
		{
			time = 175.0
			text = qs("In an interview with Guitar World he said that James used to play the opening riff on the D String and that it sounded really funny...")
		}
		{
			time = 190.0
			text = qs("At one point James moved it over onto the low E-string which changed it from being funny into a metal riff.")
		}
		{
			time = 205.0
			text = qs("James said that the band wanted to write another song like 'Creeping Death' with open chords carried by the vocals and a real catchy chorus.")
		}
		{
			time = 225.0
			text = qs("Which is more fun, screaming 'Die' at the top of your lungs or screaming 'Master'?")
		}
		{
			time = 240.0
			text = qs("To celebrate the 20th anniversary of the 'Master of Puppets' album release, hard rock magazine Kerrang! had a number of heavy artists rerecord every track from the album...")
		}
		{
			time = 260.0
			text = qs("...including Trivium doing 'Master of Puppets'.")
		}
		{
			time = 275.0
			text = qs("In 2006 Metallica appeared on the animated T.V. show 'The Simpsons' in the back of Hans Moleman's pickup truck performing a brief part of the intro to 'Master of Puppets'.")
		}
		{
			time = 298.0
			clear_text
		}
	]
}
