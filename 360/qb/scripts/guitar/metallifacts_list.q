hitthelights_metallifacts = {
	array = [
		{
			time = 10.0
			text = qs("'Hit the Lights' was the first song that Metallica ever wrote.")
		}
		{
			time = 20.0
			text = qs("The band originally recorded the song for the metal compilation album 'Metal Massacre'.")
		}
		{
			time = 30.0
			text = qs("On that version of the song, James Hetfield sang, played rhythm guitar and bass, Lars Ulrich played drums, and Lloyd Grant played a guitar solo.")
		}
		{
			time = 45.0
			text = qs("Later pressings of the 'Metal Massacre' album had a solo by Dave Mustaine.")
		}
		{
			time = 55.0
			text = qs("'Metal Massacre' was the first in a series of compilation albums of underground metal bands put out by Brian Slagel of Metal Blade Records.")
		}
		{
			time = 70.0
			text = qs("There would eventually be over a dozen 'Metal Massacre' albums that would feature a number of notable metal bands such as...")
		}
		{
			time = 85.0
			text = qs("...Armored Saint on 'Metal Massacre II', Slayer on 'Metal Massacre III', Voivod on 'Metal Massacre V', and Flotsam and Jetsam on 'Metal Massacre VII'.")
		}
		{
			time = 100.0
			text = qs("Metallica delivered 'Hit the Lights' to Brian Slagel on a cassette tape even though he was expecting a professional reel-to-reel tape.")
		}
		{
			time = 115.0
			text = qs("'Hit the Lights' also appeared as the opening track to Metallica's 1983 debut album 'Kill 'Em All' with Kirk Hammett on lead guitar.")
		}
		{
			time = 130.0
			text = qs("'Kill 'Em All' was recorded in Rochester, NY in May and June of 1983.")
		}
		{
			time = 1400.0
			text = qs("'Hit the Lights' also appeared on Metallica's 'No Life 'Till Leather' demo.")
		}
		{
			time = 150.0
			text = qs("The opening line of the lyrics to 'Hit the Lights' is 'No life 'till leather'.")
		}
		{
			time = 160.0
			text = qs("When Metallica played shows early on, 'Hit the Lights' would be one of the few original songs they would play...")
		}
		{
			time = 175.0
			text = qs("...But most clubs demanded bands play originals.  So Metallica would play a bunch of NWOBM songs since no one knew the difference.")
		}
		{
			time = 190.0
			text = qs("Back in 1982, Metallica would open almost every show with 'Hit the Lights'.")
		}
		{
			time = 200.0
			text = qs("'Hit the Lights' was one of the songs brought in from James' previous band 'Leather Charm' and was re-worked to the version you hear now.")
		}
		{
			time = 218.0
			clear_text
		}
	]
}
