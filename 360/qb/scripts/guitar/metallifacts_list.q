aceofspades_metallifacts = {
	array = [
		{
			time = 10.0
			text = qs("Taken from the band's 4th album of the same name, 'Ace of Spades' is considered by many as the definitive Motörhead anthem.")
		}
		{
			time = 25.0
			text = qs("Bassist/Frontman Lemmy has said that he's become 'sick' of performing it, but thinks it wouldn't be right if they ever stopped playing it.")
		}
		{
			time = 40.0
			text = qs("A 12 inch vinyl pressing of the song had a special Christmas picture sleeve that had the band dressed up in Santa Claus outfits on it.")
		}
		{
			time = 55.0
			text = qs("In December 1995, the members of Metallica dressed up as Lemmy and performed 7 Motörhead covers calling themselves 'The Lemmys'.")
		}
		{
			time = 70.0
			text = qs("4 of the songs 'Overkill', 'Damage Case', 'Stone Dead Forever', and 'Too Late Too Late' appeared on Metallica's 1998 album 'Garage Inc.'")
		}
		{
			time = 85.0
			text = qs("Motörhead returned the favor and won a Best Metal Performance Grammy in 2005 for their version of Metallica's 'Whiplash'.")
		}
		{
			time = 100.0
			text = qs("Motörhead performed 'Ace of Spades' live on the BBC TV show 'Top of The Pops' in October 1980.")
		}
		{
			time = 110.0
			text = qs("Originally the song was going to be based in the key of A, but Lemmy wasn't happy about it so they based it in E.")
		}
		{
			time = 125.0
			text = qs("The lyrics reference the 'Dead man's hand' - Aces and Eights which was called such because Wild Bill Hickock was supposedly holding that hand when he was shot and killed.")
		}
		{
			time = 140.0
			text = qs("In 1982, Motörhead guitarist Fast Eddie Clarke left the band and formed Fastway with former UFO bassist Pete Way.")
		}
		{
			time = 155.0
			text = qs("This version of 'Ace of Spades' was re-recorded by the band in 2008 with the lineup of Mikkey Dee on drums, Phil Campbell on guitar and of course Lemmy on bass and vocals.")
		}
		{
			time = 180.0
			clear_text
		}
	]
}
albatross_metallifacts = {
	array = [
		{
			time = 10.0
			text = qs("'Albatross' is the second track on Corrosion of Conformity's 1994 album 'Deliverance'.")
		}
		{
			time = 20.0
			text = qs("'Deliverance' was the first album in which Pepper Keenan was the lead vocalist.")
		}
		{
			time = 30.0
			text = qs("As seen in the 2004 Metallica film 'Some Kind of Monster', Pepper Keenan was invited by James Hetfield to audition for the vacant bass player position.")
		}
		{
			time = 45.0
			text = qs("Corrosion of Conformity, or C.O.C. was formed in 1982 as a hardcore punk band in Raleigh, North Carolina.")
		}
		{
			time = 55.0
			text = qs("Pepper Keenan joined C.O.C. in 1990 when the band started to adopt a more Southern Rock/Metal type sound.")
		}
		{
			time = 65.0
			text = qs("Lead guitarist and founding member Woody Weatherman has been a part of C.O.C. since its inception.")
		}
		{
			time = 75.0
			text = qs("The cover artwork for C.O.C.'s 1985 album 'Animosity' was created by Brian 'Pushead' Schroeder who has created many pieces of art for Metallica such as...")
		}
		{
			time = 90.0
			text = qs("...The album cover for 'St. Anger', the 'One' single cover, the 'Eye of the Beholder' single cover and the 'Cliff 'Em All' videotape cover.")
		}
		{
			time = 100.0
			text = qs("James Hetfield even sang backup vocals on the song 'Man or Ash' from C.O.C.'s 1996 album 'Wiseblood'.")
		}
		{
			time = 110.0
			text = qs("C.O.C. opened for Metallica on the 1996 'Poor Touring Me' tour in Europe.")
		}
		{
			time = 120.0
			text = qs("Vocalist Pepper Keenan was a member of the metal supergroup Down which also had members from bands like Crowbar, Eyehategod and Pantera.")
		}
		{
			time = 135.0
			text = qs("C.O.C. bassist Mike Dean also sang lead vocals on the track 'Access Babylon' for Foo Fighter frontman Dave Grohl's metal side project Probot.")
		}
		{
			time = 150.0
			text = qs("'Albatross' was a chart hit for the band, peaking at #19 on the Hot Mainstream Rock tracks chart.")
		}
		{
			time = 165.0
			text = qs("The 'Deliverance' album also spawned another top 20 hit with 'Clean My Wounds' and the album peaked at #5 on the Billboard Heatseekers chart.")
		}
		{
			time = 178.0
			clear_text
		}
	]
}
allnightmarelong_metallifacts = {
	array = [
		{
			time = 10.0
			text = qs("'All Nightmare Long' is the fifth track on Metallica's ninth studio album 'Death Magnetic'.")
		}
		{
			time = 25.0
			text = qs("The demo version of the song was originally called 'Flamingo'.")
		}
		{
			time = 40.0
			text = qs("The 'Death Magnetic' album was released on September 10, 2008.")
		}
		{
			time = 55.0
			text = qs("'Death Magnetic' debuted at #1 on the Billboard 200 in the U.S.  Making Metallica the first band ever to have five consecutive albums debut at #1.")
		}
		{
			time = 75.0
			text = qs("'Death Magnetic' was the first Metallica album to feature the playing of Rob Trujillo on the bass.")
		}
		{
			time = 90.0
			text = qs("It was also the first Metallica album produced by Rick Rubin who has produced a number of legendary albums including...")
		}
		{
			time = 105.0
			text = qs("The Beastie Boys' 'Licensed to Ill', Slayer's 'Reign in Blood', Danzig's self-titled debut and Johnny Cash's 'American Recordings'.")
		}
		{
			time = 125.0
			text = qs("Rick Rubin encouraged Metallica to go back and listen to the music that inspired them in their early days.")
		}
		{
			time = 150.0
			text = qs("'Death Magnetic' is seen as a return to form among many fans and critics alike...")
		}
		{
			time = 165.0
			text = qs("...Kerrang! magazine wrote that 'Death Magnetic' is 'As exciting as it is simply heavy.  There is life in the old gods yet.'")
		}
		{
			time = 185.0
			text = qs("Regarding the lyrics for 'Death Magnetic' James Hetfield has said '...I wanted them to be somewhat anonymous but powerful...'")
		}
		{
			time = 200.0
			text = qs("On June 6, 2006 in Berlin, Metallica debuted 'The New Song'.  Parts of 'All Nightmare Long' and 'The End of the Line' can be heard in 'The New Song'.")
		}
		{
			time = 220.0
			text = qs("James Hetfield has said that 'All Nightmare Long' was substantially more work than the other songs on 'Death Magnetic' and it went through a few incarnations musically and lyrically.")
		}
		{
			time = 248.0
			clear_text
		}
	]
}
AmIEvil_metallifacts = {
	array = [
		{
			time = 10.0
			text = qs("'Am I Evil?' was the 4th track on Diamond Head's 1980 debut album 'Lightning to the Nations'.")
		}
		{
			time = 20.0
			text = qs("The song intro has a riff that is based on English composer Gustav Holst's 'Mars' from 'The Planets Suite Op. 32'")
		}
		{
			time = 30.0
			text = qs("Metallica released a version of 'Am I Evil?' as the B-side to the 'Creeping Death' single in 1984.")
		}
		{
			time = 40.0
			text = qs("The Metallica version also appeared on Metallica's 1998 album Garage Inc.")
		}
		{
			time = 50.0
			text = qs("Diamond Head were one of the leading members of the New Wave of British Heavy Metal that had a heavy influence on Metallica.")
		}
		{
			time = 60.0
			text = qs("Metallica has covered multiple Diamond Head songs including 'Am I Evil?', 'It's Electric', 'Helpless', and 'The Prince'.")
		}
		{
			time = 70.0
			text = qs("There are even old demo versions of Metallica covering Diamond Head's 'Sucking My Love'.")
		}
		{
			time = 80.0
			text = qs("Metallica drummer Lars Ulrich has even said that 'Seek and Destroy' was greatly inspired by Diamond Head's song 'Dead Reckoning'.")
		}
		{
			time = 100.0
			text = qs("When Lars was only 17 he flew out to England to watch Diamond Head play and wound up living with the band for a few weeks.")
		}
		{
			time = 110.0
			text = qs("In 1993, Diamond Head opened for Metallica at Milton Keynes Bowl for an audience of about 60,000 people.")
		}
		{
			time = 120.0
			text = qs("The members of Diamond Head have said that it is an honor to have influenced Metallica and guitarist Brian Tatler once said that Metallica's recordings of their songs has helped him buy a house.")
		}
		{
			time = 135.0
			text = qs("Guitarist Brian Tatler got the band name from the 1975 album 'Diamond Head' by Phil Manzanera.")
		}
		{
			time = 145.0
			text = qs("Diamond Head cut their first demo tape in 1978 which they used to help get gigs and even landed them opening slots for AC/DC and Iron Maiden.")
		}
		{
			time = 160.0
			text = qs("Diamond Head's 'Lightning To the Nations' album is often referred to as The White LP because of its all white cover.")
		}
		{
			time = 170.0
			text = qs("Legend has it that the band's manager owned a cardboard factory and could produce blank covers cheaply.")
		}
		{
			time = 180.0
			text = qs("The album was released through the band's own label Happy Face Records in 1980, and they pressed 1000 copies each with one signature from a band member on it.")
		}
		{
			time = 190.0
			text = qs("Sanctuary Records re-released 'Lightning to the Nations' in 2001")
		}
		{
			time = 200.0
			text = qs("The band were getting set to record a fourth album in 1984 when they were dropped by their record label and the band broke up.")
		}
		{
			time = 210.0
			text = qs("The members of Diamond Head later reunited and joined Metallica on stage for live versions of 'Am I Evil?' and 'Helpless' in 1992 at the National Exhibition Centre in Birmingham, Great Britain.")
		}
		{
			time = 225.0
			text = qs("'Am I Evil?' is a staple of live Metallica shows and occassionally the band will change it up and James Hetfield will play drums while Lars Ulrich sings lead vocals.")
		}
		{
			time = 235.0
			text = qs("Diamond Head's 1993 album 'Death and Progress' featured a track co-written by Megadeth's Dave Mustaine.")
		}
		{
			time = 245.0
			text = qs("Black Sabbath guitarist Tony Iommi also made a guest appearance on 'Death and Progress'")
		}
		{
			time = 263.0
			clear_text
		}
	]
}
ArmedAndReady_metallifacts = {
	array = [
		{
			time = 10.0
			text = qs("'Armed and Ready' is the opening track on The Michael Schenker Group's self-titled debut album.")
		}
		{
			time = 20.0
			text = qs("Metallica lead guitarist Kirk Hammett has said that Michael Schenker is one of his all-time favorite guitarists.")
		}
		{
			time = 30.0
			text = qs("Prior to forming The Michael Schenker Group, or MSG, Michael Schenker joined the hard rock band UFO which Kirk has mentioned as his favorite band.")
		}
		{
			time = 45.0
			text = qs("Michael was also a member of heavy metal/hard rock legends Scorpions along with his older brother rhythm guitarist Rudolf Schenker.")
		}
