			time = 55.0
			text = qs("Schenker joined the band Ratt for a brief time after guitarist Robbin Crosby left the band.")
		}
		{
			time = 65.0
			text = qs("Schenker even auditioned for Aerosmith when Joe Perry left the band.")
		}
		{
			time = 75.0
			text = qs("In 2008, web magazine Roadie Crew ran a poll where they asked 330 guitarists to list their favorite guitarists of all time...")
		}
		{
			time = 85.0
			text = qs("...They polled artists such as Machine Head, King Diamond, Down, etc.  Michael Schenker was voted #10...")
		}
		{
			time = 95.0
			text = qs("Also on the list were Kirk Hammett at #32, and James Hetfield at #16.")
		}
		{
			time = 105.0
			text = qs("Michael Schenker is known for playing a Flying V shaped guitar which Kirk used to favor in Metallica's early days.")
		}
		{
			time = 115.0
			text = qs("In an interview with Guitar World magazine Kirk once said 'I love Michael Schenker because he plays the hookiest solos...'")
		}
		{
			time = 125.0
			text = qs("'...I've always been attracted to players who are not necessarily melodic but very hooky.'")
		}
		{
			time = 133.0
			clear_text
		}
	]
}
