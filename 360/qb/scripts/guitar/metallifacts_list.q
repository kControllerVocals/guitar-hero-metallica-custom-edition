			text = qs("And at the 2006 Download festival Alice In Chains guitarist Jerry Cantrell joined Metallica on stage for 'Nothing Else Matters'.")
		}
		{
			time = 140.0
			text = qs("At the band's 1996 unplugged TV performance, bassist Mike Inez had the phrase 'Friends Don't Let Friends Get Friends Haircuts' written on his bass...")
		}
		{
			time = 155.0
			text = qs("...which was in reference to the members of Metallica who were in the audience and who had just cut their hair prior to the release of the 'Load' album.")
