		{
			time = 25.0
			text = qs("'...And Justice for All' was the first full Metallica album featuring bassist Jason Newsted.")
		}
		{
			time = 40.0
			text = qs("Lars has said that 'The Shortest Straw' is one of his favorite Metallica songs from the '80's.")
		}
