			text = qs("James also said that when he sat in the control room listening to the gang vocals of everyone chanting 'Die' during the bridge everyone was going nuts.")
		}
		{
			time = 250.0
			text = qs("Flemming Rasmussen, engineer and producer on the 'Ride the Lightning' album suggested that Kirk double track the guitar solo to give it a thicker sound.")
		}
		{
			time = 270.0
			text = qs("At the end of the solo Kirk said he played a chordal exercise he learned from Joe Satriani to add an accent to the final 4 notes.")
		}
		{
			time = 285.0
			text = qs("Flemming Rasmussen would also work with Metallica on the follow up album 'Master of Puppets', and '..And Justice for All'.")
		}
		{
			time = 305.0
			text = qs("'Creeping Death' has always been a crowd favorite.  There's just something therapeutic about shouting 'Die' at the top of your lungs.")
		}
		{
			time = 325.0
			text = qs("The title of the song came from late Metallica bassist Cliff Burton while the band was watching the film 'The Ten Commandments.'")
		}
		{
			time = 340.0
			text = qs("Cliff said that the death plague in the film was like 'creeping death'.")
		}
		{
			time = 363.0
			clear_text
		}
	]
}
demoncleaner_metallifacts = {
