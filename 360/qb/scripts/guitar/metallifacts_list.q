		}
		{
			time = 20.0
			text = qs("The album is called '(pronounced 'leh-'nerd 'skin-'nerd)' but has typically been referred to as 'Pronounced'.")
		}
		{
			time = 30.0
			text = qs("'Pronounced' is #401 on the Rolling Stone 500 Greatest Albums of all time.")
		}
		{
			time = 40.0
			text = qs("Skynyrd's enduring classic 'Free Bird' is the final track on the album.")
		}
		{
			time = 50.0
			text = qs("Guitar Hero fans know 'Free Bird' as the final encore song in Guitar Hero II.")
		}
		{
			time = 60.0
			text = qs("The Metallica version of 'Tuesday's Gone' that appears on 'Garage Inc.' was recorded live at a radio station during a promotion for the 'ReLoad' album in 1997.")
		}
		{
			time = 75.0
			text = qs("Metallica's version had a number of special guest appearances including John Popper of Blues Traveller on harmonica...")
		}
		{
			time = 85.0
			text = qs("...Jerry Cantrell and Sean Kinney of Alice in Chains on guitar and drums.  Les Claypool of Primus on banjo...")
		}
		{
			time = 95.0
			text = qs("...Pepper Keenan of Corrosion of Conformity and Jim Martin formerly of Faith No More on guitar...")
		}
		{
			time = 105.0
			text = qs("...And Lynyrd Skynyrd founding member Gary Rossington on guitar.")
		}
		{
			time = 115.0
			text = qs("Country music legend Hank Williams Jr. recorded a version 'Tuesday's Gone' for the 1994 tribute album 'Skynyrd Frynds'.")
		}
		{
			time = 130.0
			text = qs("Lynyrd Skynyrd was formed in 1965 by Ronnie Van Zant, Gary Rossington, Allen Collins, Leon Wilkeson and Bob Burns in high school in Jacksonville, Florida.")
		}
		{
			time = 145.0
			text = qs("The band was initially called 'My Backyard' but changed their name to immortalize their gym teacher Leonard Skinner who was notoriously hard on long haired students.")
		}
		{
			time = 160.0
			text = qs("On October 20, 1977 the band was involved in a plane crash while flying to a gig in Louisiana that killed a number of people including vocalist Ronnie Van Zant.")
		}
		{
			time = 175.0
			text = qs("Out of respect for the deceased the band's record label pulled the sleeve of the band's just released album 'Street Survivors' that had pictures of the band standing in flames.")
		}
		{
			time = 190.0
			text = qs("'Street Survivors' would go on to become Lynyrd Skynyrd's second platinum album.")
		}
		{
			time = 200.0
			text = qs("'Tuesday's Gone' has been featured in a number of movies including 'Dazed and Confused' from 1993 and 'Happy Gilmore' from 1996.")
		}
		{
			time = 215.0
			text = qs("Talking about 'Tuesday's Gone', James Hetfield once said 'I always loved that one.  It's a movin'-on song - you're splitting, you're leaving your woman at home. You're off doing your own thing.  It really fits the road.'")
		}
		{
			time = 235.0
			text = qs("James Hetfield also said that Lynyrd Skynyrd's 'Sweet Home Alabama' was the first record he ever bought with his lawn mowing allowance.")
		}
		{
			time = 250.0
			text = qs("He also said that 'Tuesday's Gone' was very moving to him and being able to record the song with Lynyrd Skynyrd guitarist Gary Rossington was an honor.")
		}
		{
			time = 265.0
			text = qs("When talking about 'Tuesdays Gone', Lars Ulrich said 'A little known fact... The cover songs actually pick themselves!  Certain songs just feel like Metallica should play them.'")
		}
		{
			time = 283.0
			clear_text
		}
	]
}
