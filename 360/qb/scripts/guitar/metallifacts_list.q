creepingdeath_metallifacts = {
	array = [
		{
			time = 10.0
			text = qs("'Creeping Death' is the 7th track on Metallica's 1984 album 'Ride The Lightning'.")
		}
		{
			time = 25.0
			text = qs("'Creeping Death' has been played live by the band more than any other Metallica song.")
		}
		{
			time = 45.0
			text = qs("There are mentions of the Plagues of Egypt throughout the song...")
		}
		{
			time = 60.0
			text = qs("'Blood, Running red and strong, down the Nile' - The first plague, water turned to blood...")
		}
		{
			time = 75.0
			text = qs("'Darkness three days long' - The ninth plague, darkness for three days...")
		}
		{
			time = 90.0
			text = qs("'Hail to Fire' - The seventh plague, a storm of hail and fire.")
		}
		{
			time = 105.0
