		}
		{
			time = 15.0
			text = qs("The 'Gods of the Earth' album was the band's first exposure to chart success.  The album peaked at #1 on the Top Heatseekers Billboard chart and #102 on the Billboard 200.")
		}
		{
			time = 30.0
			text = qs("The band heard a rumor that Metallica drummer Lars Ulrich was a fan of the band's debut record 'Age of Winters'.")
		}
		{
			time = 50.0
			text = qs("As a joke the band started putting Lars Ulrich on the guest list for the shows each night.")
		}
		{
			time = 60.0
			text = qs("Lars didn't show up until the band played at San Francisco's Slim's with Trivium.")
		}
		{
			time = 70.0
			text = qs("The band was then invited on a seven gig European tour with Metallica and Down.")
		}
		{
			time = 80.0
			text = qs("The Sword are also touring with Metallica on their 'Death Magnetic' Tour.")
		}
		{
			time = 90.0
			text = qs("The Sword first entered the Guitar Hero universe in 2006 when a cover version of their song 'Freya' appeared in Guitar Hero II.")
		}
		{
			time = 100.0
			text = qs("Let's just sit back and enjoy the real Sword for a moment.")
		}
		{
