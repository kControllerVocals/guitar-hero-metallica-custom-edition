frantic_metallifacts = {
	array = [
		{
			time = 10.0
			text = qs("'Frantic' is the first song and the second single from Metallica's 2003 album 'St. Anger'.")
		}
		{
			time = 20.0
			text = qs("The name Frantic was once considered as the name of the album.")
		}
		{
			time = 30.0
			text = qs("'St. Anger', Metallica's 8th studio album was released on June 5, 2003.")
		}
		{
			time = 40.0
			text = qs("The album went to #1 in 30 countries including a debut at #1 on the U.S. charts.")
		}
		{
			time = 50.0
			text = qs("On the b-side of one of the 'Frantic' singles was a version of the song remixed by U.N.K.L.E.")
		}
		{
			time = 60.0
			text = qs("U.N.K.L.E. has remixed songs from a variety of artists such as Oasis, Beck and Queens of the Stone Age.")
		}
		{
			time = 70.0
			text = qs("The video for 'Frantic' was directed by Wayne Isham who also directed Metallica's 'Enter Sandman' video...")
		}
		{
			time = 80.0
			text = qs("The video was shot on July 21, 2003 in a Montreal junkyard after a Summer Sanitarium 2003 tour stop.")
		}
		{
			time = 90.0
			text = qs("Wayne also directed the DVD that was packaged with the 'St. Anger' album...")
		}
		{
			time = 100.0
			text = qs("Wayne also directed the video for 'Livin' la Vida Loca' by Ricky Martin.")
		}
		{
			time = 110.0
			text = qs("Drummer Lars Ulrich has said that 'Frantic' is a great 5 minute journey into what the next 75 minutes on the record are like.")
		}
		{
			time = 125.0
			text = qs("Guitarist Kirk Hammett said that the band wrote 'Frantic' in one afternoon.")
		}
		{
			time = 135.0
			text = qs("Kirk has also said that he tapped a lot of 'Zen' philosophy for the lyrics of 'Frantic'.")
		}
		{
			time = 145.0
			text = qs("The songs lyrics are based on the idea of counting down how many days you have left to live and what would you do differently.")
		}
		{
			time = 160.0
			text = qs("Even though it's over 5 minutes long, 'Frantic' is still one of shortest songs on the album.  The longest being 'All Within My Hands' which is almost 9 minutes long.")
		}
		{
			time = 180.0
			text = qs("'Frantic' was debuted live in a truncated form during the MTV Icon show...")
		}
		{
			time = 190.0
			text = qs("The song was later debuted in full on May 18, 2003 at the Fillmore in San Francisco.")
		}
		{
			time = 203.0
			clear_text
		}
	]
}
