							value = (0.0465, 0.0, 0.0)
						}
					}
					{
						bone = Bone_Forearm_R
						scaling = {
							value = (0.0465, 0.0, 0.0)
							stop_propagate
						}
					}
					{
						bone = Bone_Palm_R
						scaling = {
							value = (-0.1, -0.1, -0.1)
						}
					}
					{
						bone = Bone_Bicep_L
